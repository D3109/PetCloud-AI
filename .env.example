# Coincide con las credenciales de docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://petcloud:petcloud@localhost:5432/petcloud_ia
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GOOGLE_API_KEY=your-api-key-here
AI_MODEL=gemini-3.8-flash

# Debe ser EXACTAMENTE igual a GOOGLE_CLIENT_ID en frontend/js/config.js.
# Sin esto, "Ingresar con Google" responde 501 (el botón igual se ve, pero
# el backend no puede verificar el token).
GOOGLE_OAUTH_CLIENT_ID=72687542411-541av0c65vu7puv5vqimkm4c88tvp2r6.apps.googleusercontent.com